# backend/.env 로 복사 후 사용 (선택)

# --- 보안 설정 ---
# 관리자 API(/api/refresh-knowledge, /api/run-crawlers) 보호용 키 (설정 안 하면 인증 없음)
# ADMIN_SECRET_KEY=여기에_임의의_비밀키_입력

# 허용할 CORS 도메인 (쉼표 구분, 미설정 시 localhost:5173만 허용)
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- RAG 튜닝 ---
# 벡터 검색 시 반환할 문서 수 (기본 3, 늘리면 정확도↑ 속도↓)
# RAG_RETRIEVAL_K=3

#
# 필수(한 번만): 임베딩용 모델 받기 — 안 하면 404
#   ollama pull nomic-embed-text
#
# Ollama 기본 주소
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# 채팅(RAG 답변) 모델 — 필수: ollama pull llama3.2 (또는 아래 이름에 맞게)
# OLLAMA_MODEL=gemma4:latest
# 벡터 임베딩 모델 — 위에서 pull 한 이름과 동일해야 함. 바꾸면 chroma_db 삭제 후 build_vectordb 재실행
# OLLAMA_EMBED_MODEL=joonoh/HyperCLOVAX-SEED-Text-Instruct-1.5B:latest

# --- OpenAI (ChatOpenAI) — 요약 엔진에서 OpenAI / 비교 선택 시 필요 ---
# OPENAI_API_KEY=sk-...
# 채팅 모델 (기본 gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# 호환 API·프록시 사용 시에만 (공식 엔드포인트면 비워 둠)
# OPENAI_BASE_URL=https://api.openai.com/v1
# 조직 ID (선택)
# OPENAI_ORG_ID=

# RAG API 응답의 출처(content) 최대 글자 수 (기본 4096)
# RAG_SOURCE_CONTENT_MAX=4096

# RAG LLM 직전 프롬프트 출력 (기본 0=OFF). 개발 시 켜려면 RAG_DEBUG_PRINT=1
# RAG_DEBUG_PRINT=1
# 출력 미리보기 최대 글자 (기본 20000)
# RAG_DEBUG_PRINT_MAX=20000
